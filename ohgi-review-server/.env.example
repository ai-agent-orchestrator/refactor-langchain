FAKE_LLM=true
FAKE_LLM_DELAY_SECONDS=0.2
# 학교 예시 모델. 본인 계정의 접근 여부는 실제 호출 시 확인합니다.
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=300
# 실제 호출: FAKE_LLM=false로 변경하고 아래 키를 로컬 .env에만 입력
# OPENAI_API_KEY=여기에_본인_키
RAG_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
RAG_K=4
# FAKE_LLM=true: 오프라인 해시 임베딩 + 실제 Chroma 경로 시험
# FAKE_LLM=false: 실제 OpenAI 임베딩 + 답글 모델 (각각 API 비용 발생)
